//kelvin will always be 293
const kelvinTemperature = 293
//celsius is 273 less than kelvin
let celsius = kelvinTemperature - 273
//fahrenheit's equation
var fahrenheit = celsius * (9/5) + 32
//When you convert from Celsius to Fahrenheit, you often get a decimal number. We are rounding it down to a whole number
fahrenheit = Math.floor(fahrenheit)

console.log(`The temperature is ${fahrenheit} degrees Fahrenheit.`)
